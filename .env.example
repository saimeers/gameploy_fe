# ── API ───────────────────────────────────────────────────────────────────────
# Base de la API, incluyendo /api/v1. También es la base del iframe que ejecuta
# el juego WebGL (VITE_API_URL/play/...).
VITE_API_URL=http://localhost:3000/api/v1
# Alternativa local usada como respaldo si VITE_API_URL no está definida
VITE_API_URL_DEV=http://localhost:3000/api/v1

# ── Firebase (SDK cliente) ────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-firebase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-firebase
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-firebase.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
